@import url('https://fonts.googleapis.com/css2?family=Special+Elite&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap');
@import 'tailwindcss';

* { box-sizing: border-box; }
html, body, #root { height: 100%; margin: 0; padding: 0; }

body {
  background: #0b0c10;
  color: #c4c8d4;
  font-family: 'Rajdhani', system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(212,160,23,0.2); }

.font-typewriter { font-family: 'Special Elite', Georgia, serif; }
.font-courier    { font-family: 'Courier Prime', 'Courier New', monospace; }
.font-mono-hud   { font-family: 'Share Tech Mono', monospace; }
.font-raj        { font-family: 'Rajdhani', sans-serif; }

@keyframes blink {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0; }
}
@keyframes stamp-in {
  0%   { transform: scale(2.4) rotate(-8deg); opacity: 0; }
  60%  { transform: scale(0.95) rotate(1deg); opacity: 1; }
  100% { transform: scale(1) rotate(-2deg); opacity: 1; }
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20%       { transform: translateX(-6px); }
  40%       { transform: translateX(6px); }
  60%       { transform: translateX(-4px); }
  80%       { transform: translateX(4px); }
}
@keyframes pulse-border {
  0%, 100% { box-shadow: 0 0 0 0 rgba(212,160,23,0); }
  50%       { box-shadow: 0 0 0 6px rgba(212,160,23,0.12); }
}
@keyframes scan-line {
  0%   { top: -4px; }
  100% { top: 100%; }
}
@keyframes flicker {
  0%, 95%, 100% { opacity: 1; }
  96%            { opacity: 0.6; }
  97%            { opacity: 1; }
  98%            { opacity: 0.4; }
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes timer-drain {
  from { width: 100%; }
  to   { width: 0%; }
}

.blink       { animation: blink 1.1s step-end infinite; }
.shake       { animation: shake 0.4s ease; }
.stamp-in    { animation: stamp-in 0.45s cubic-bezier(0.22,1,0.36,1) forwards; }
.fade-in     { animation: fadeIn 0.3s ease forwards; }
.flicker     { animation: flicker 7s infinite; }
.pulse-border{ animation: pulse-border 2.5s ease-in-out infinite; }

.noise::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  opacity: 0.06;
  pointer-events: none;
  border-radius: inherit;
}

.leaderboard-row {
  display: grid;
  grid-template-columns: minmax(180px, 1.8fr) repeat(3, minmax(72px, 0.7fr));
  align-items: center;
  gap: 12px;
  min-height: 54px;
  padding: 10px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  color: #8a8fa0;
  font-family: 'Share Tech Mono', monospace;
  font-size: 11px;
}

.leaderboard-header {
  min-height: 36px;
  color: #3a4050;
  font-size: 8px;
  letter-spacing: 0.12em;
  background: rgba(255,255,255,0.02);
}

@media (max-width: 820px) {
  .career-card {
    top: 12px !important;
    right: 12px !important;
    width: 180px !important;
  }
}

@media (max-width: 620px) {
  .career-card {
    display: none;
  }

  .leaderboard-row {
    grid-template-columns: minmax(150px, 1.8fr) repeat(2, minmax(62px, 0.7fr));
    padding: 10px;
  }

  .leaderboard-row > :last-child {
    display: none;
  }
}
